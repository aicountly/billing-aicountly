# ---------------------------------------------------------------------------
# Billing mobile — Expo build environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER committed.
#
# IMPORTANT — like the web app's VITE_* vars, EXPO_PUBLIC_* values are inlined
# at BUILD time (by Metro/babel-preset-expo), not read at runtime. Changing one
# means rebuilding — restarting `expo start` picks up a new .env for a fresh
# JS bundle, but a shipped binary needs a new build.
#
# Never put a secret here — anything EXPO_PUBLIC_* is public once built.
# ---------------------------------------------------------------------------

# --- API endpoint ----------------------------------------------------------
# Base URL of this product's PHP API. Unlike the web app, the mobile app has
# no "same origin" to fall back to, so this must always be set explicitly.
#
#   https://billing.aicountly.com/api        (production)
#   https://billing.gh.aicountly.com/api     (sandbox)
EXPO_PUBLIC_API_BASE_URL=https://billing.gh.aicountly.com/api

# --- App identity ----------------------------------------------------------
EXPO_PUBLIC_APP_NAME=Billing

# Deploy target this build is for: local | sandbox | production
EXPO_PUBLIC_APP_ENV=local

# --- Authentication --------------------------------------------------------
# Portal authentication_jump product key. Defaults to "billing" — the mobile
# app has no hostname to derive it from, so it is not optional the way the
# web app's VITE_PRODUCT_KEY is.
EXPO_PUBLIC_PRODUCT_KEY=billing

# Login portal origin. Production is https://my.aicountly.com and sandbox is
# https://sandbox.aicountly.com. The auth API (seskey, refresh, validatesession)
# is always my.aicountly.com regardless of this value — see
# ../docs/auth/AICOUNTLY_AUTH_WORKFLOW.md and mobile/README.md.
EXPO_PUBLIC_PORTAL_LOGIN_URL=https://sandbox.aicountly.com
